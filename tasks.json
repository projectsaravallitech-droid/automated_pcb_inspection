{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build OpenCV Project (MSVC)",
      "type": "shell",
      "command": "cl",
      "args": [
        "/EHsc",
        "main.cpp",
        "VideoStream.cpp",
        "UI.cpp",
        "/IC:\\opencv\\build\\include",
        "/link",
        "/LIBPATH:C:\\opencv\\build\\x64\\vc16\\lib",
        "opencv_world4120.lib",
        "/OUT:app.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}